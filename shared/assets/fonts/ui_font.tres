[gd_resource type="FontVariation" load_steps=4 format=3]

; 프로젝트 기본 폰트 (project.godot의 gui/theme/custom_font).
; 번들 폰트인 Noto Sans KR은 라틴·키릴·한글·가나는 덮지만
; 터키어 ğ / 폴란드어 ł / 간체 전용 한자 / 의사 로케일 악센트가 빠져 있다.
; 빠진 글리프는 아래 폴백 체인이 OS 폰트에서 메운다 (스팀=데스크톱 기준).
; 웹·안드로이드처럼 시스템 폰트를 못 쓰는 타깃을 지원하게 되면
; Noto Sans SC/TC/JP .otf를 여기 FontFile 폴백으로 추가할 것.

[ext_resource type="FontFile" uid="uid://bue8x5tspsiy5" path="res://shared/assets/fonts/NotoSansKR-Regular.otf" id="1_base"]

[sub_resource type="SystemFont" id="SystemFont_latin"]
font_names = PackedStringArray("Noto Sans", "Segoe UI", "DejaVu Sans", "Arial")
allow_system_fallback = true
subpixel_positioning = 1

[sub_resource type="SystemFont" id="SystemFont_cjk"]
font_names = PackedStringArray("Microsoft YaHei", "Noto Sans SC", "PingFang SC", "Microsoft JhengHei", "Noto Sans TC", "Meiryo", "Noto Sans JP", "Malgun Gothic")
allow_system_fallback = true
subpixel_positioning = 1

[resource]
base_font = ExtResource("1_base")
fallbacks = Array[Font]([SubResource("SystemFont_latin"), SubResource("SystemFont_cjk")])
